import /init.recovery.wifi.rc

on early-fs
    write /proc/sys/walt/sched_lib_name "recovery,Updater,updater,update_engine_sideload"
    write /proc/sys/walt/sched_lib_mask_force 255
    mkdir -p /dev/mink 0770 system drmrpc  # MinkIPC通信依赖

service post-boot-script /system/bin/sh -c /vendor/bin/init.kernel.post_boot-pineapple_default_2_3_2_1.sh
    user root
    group root
    oneshot
    seclabel u:r:recovery:s0

on init
    setprop sys.usb.configfs 1
    setprop prepdecrypt.setpatch true
    start vendor.boot-qti
    start vendor.gatekeeper_default
    start vendor.qseecomd  # 提前启动QSEECom，为SE服务做准备
    # 禁用未补固件的remoteproc服务（adsp/cdsp/soccp）
    write /sys/class/remoteproc/remoteproc0/state stop
    write /sys/class/remoteproc/remoteproc2/state stop
    write /sys/class/remoteproc/remoteproc3/state stop

on property:ro.boot.usbcontroller=*
    setprop sys.usb.controller ${ro.boot.usbcontroller}
    # 修复USB PHY中断缺失：先绑定PHY再设置模式
    wait /sys/devices/platform/soc/a600000.ssusb/phy
    symlink /sys/devices/platform/soc/a600000.ssusb/phy /sys/class/usb_phy
    write /sys/class/usb_phy/enable 1
    # 再配置USB模式
    wait /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode
    write /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode peripheral
    wait /sys/class/udc/${ro.boot.usbcontroller} 1

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
    write /proc/sys/kernel/firmware_config/force_sysfs_fallback 1
    chmod 0660 /dev/qseecom
    chown system drmrpc /dev/qseecom
    chmod 0664 /dev/ion
    chown system system /dev/ion
    mkdir /mnt/vendor 0775 shell system
    mkdir /mnt/vendor/persist 0775 shell system
    mkdir /tmp/persist 0775 shell system
    mount none /tmp/persist /mnt/vendor/persist bind rec
    install_keyring

on post-fs
    setprop twrp.variant.files_copied 0

on property:twrp.modules.loaded=true
    # 仅保留modem分区挂载（已补固件无需额外分区）
    mkdir /firmware
    mount vfat /dev/block/bootdevice/by-name/modem${ro.boot.slot_suffix} /firmware ro
    # 保留已补固件的符号链接（触控+振动固件加载需要）
    symlink /firmware /vendor/firmware
    # 已删除ADSP固件加载（未补固件）
    wait /sys/class/power_supply/battery
    start vendor.health-default
    start variant-script

on property:servicemanager.ready=true
    setprop sys.boot_completed 1
    start vendor.ssgtzd

on property:twrp.variant.files_copied=1
    start prepdecrypt.vendor
    umount /vendor
    start vendor.oplus.vibrator  # 启动振动服务（依赖已补固件）
    # 调整SE服务启动顺序：等待QSEECom就绪后延迟启动
    wait vendor.qseecomd
    sleep 2
    start vendor.secure_element
    start vendor.weaver_nxp
    start vendor.se_omapi

# 服务崩溃自动重启（保障加密核心服务）
on property:init.svc.vendor.secure_element=stopped
    sleep 2
    start vendor.secure_element
on property:init.svc.vendor.weaver_nxp=stopped
    sleep 2
    start vendor.weaver_nxp
on property:init.svc.vendor.keymint-qti=stopped
    sleep 2
    start vendor.keymint-qti
